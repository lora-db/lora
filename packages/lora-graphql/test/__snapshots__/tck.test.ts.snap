exports[`TCK > nested lists, sorted and unsorted 1`] = `
[
  {
    "field": "genres",
    "reads": {
      "labels": [
        "Artist",
        "Festival",
        "Genre",
      ],
      "relationships": [
        "HEADLINES",
        "IN_GENRE",
      ],
    },
    "statements": [
      {
        "params": {
          "p0": 3,
          "p1": 25,
          "p2": 25,
        },
        "text": "MATCH (this:Genre)
WHERE this.key >= ""
WITH this ORDER BY this.key ASC LIMIT $p2
CALL {
  WITH this
  MATCH (this)<-[:IN_GENRE]-(this_festivals:Festival)
  WITH this_festivals ORDER BY this_festivals.key ASC LIMIT $p0
  CALL {
    WITH this_festivals
    MATCH (this_festivals)<-[:HEADLINES]-(this_festivals_headliners:Artist)
    WITH this_festivals_headliners ORDER BY this_festivals_headliners.name ASC LIMIT $p1
    RETURN collect(this_festivals_headliners { .name }) AS this_festivals_headliners_list
  }
  RETURN collect(this_festivals { .key, headliners: this_festivals_headliners_list }) AS this_festivals_list
}
RETURN this { .key, festivals: this_festivals_list } AS this",
      },
    ],
  },
]
`;

