]
`;

exports[`TCK > connection after a cursor 1`] = `
[
  {
    "field": "festivalsConnection",
    "reads": {
      "labels": [
        "Festival",
      ],
      "relationships": [],
    },
    "statements": [
      {
        "params": {
          "p0": "Starland 11",
          "p1": "f11",
          "p2": 3,
        },
        "text": "MATCH (this:Festival)
WHERE this.name >= $p0 AND (this.name > $p0 OR (this.name = $p0 AND this.key > $p1))
WITH this ORDER BY this.name ASC, this.key ASC LIMIT $p2
RETURN this { .key } AS node, [this.name, this.key] AS __cursor",
      },
    ],
  },
]
`;

exports[`TCK > connection, plan example 1`] = `
[
  {
    "field": "festivalsConnection",
    "reads": {
      "labels": [
        "Festival",
        "Genre",
      ],
      "relationships": [
        "IN_GENRE",
      ],
    },
    "statements": [
      {
        "params": {
          "p0": "land",
          "p1": 3,
        },
        "text": "MATCH (this:Festival)
WHERE this.name CONTAINS $p0
WITH this ORDER BY this.name ASC, this.key ASC LIMIT $p1
RETURN this { .key, .name, genre: head([(this)-[:IN_GENRE]->(this_genre:Genre) | this_genre { .name }]) } AS node, [this.name, this.key] AS __cursor",
      },
    ],
  },
]
`;

