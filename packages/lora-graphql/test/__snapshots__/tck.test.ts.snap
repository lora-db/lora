exports[`public schema 1`] = `
"type Artist {
  key: ID!
  name: String!
  plays(limit: Int, sort: [FestivalSort!], where: FestivalWhere): [Festival!]!
  playsConnection(after: String, first: Int, sort: [FestivalSort!], where: FestivalWhere): FestivalConnection!
}

type ArtistConnection {
  edges: [ArtistEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type ArtistEdge {
  cursor: String!
  node: Artist!
}

input ArtistKeyFilter {
  """Equal to."""
  eq: ID

  """Equal to any of."""
  in: [ID!]
}

input ArtistNameFilter {
  """Contains the substring."""
  contains: String

  """Equal to."""
  eq: String
}

"""Sorts Artist nodes. One field per item; the @key breaks ties."""
input ArtistSort {
  key: SortDirection
  name: SortDirection
}

"""Filters Artist nodes. Absent or null filters are ignored."""
input ArtistWhere {
  AND: [ArtistWhere!]
  NOT: ArtistWhere
  OR: [ArtistWhere!]
  key: ArtistKeyFilter
  name: ArtistNameFilter
}

"""Compare the number of related nodes."""
input CountFilter {
  eq: Int
  gt: Int
  gte: Int
  lt: Int
  lte: Int
}

"""An instant with offset, e.g. \`2026-06-21T21:00:00Z\`."""
scalar DateTime

type DateTimeAggregate {
  max: DateTime
  min: DateTime
}

type Festival implements Node {
  capacity: Int
  followers(limit: Int, sort: [UserSort!], where: UserWhere): [User!]!
  followersConnection(after: String, first: Int, sort: [UserSort!], where: FestivalFollowersConnectionWhere): FestivalFollowersConnection!
  genre(where: GenreWhere): Genre
  headliners(limit: Int, sort: [ArtistSort!], where: ArtistWhere): [Artist!]!
  headlinersConnection(after: String, first: Int, sort: [ArtistSort!], where: ArtistWhere): ArtistConnection!

  """Global id."""
  id: ID!
  key: String!
  name: String!
  startsAt: DateTime
  status: Status
  title: String
}

type FestivalAggregate {
  capacity: IntAggregate!
  count: Int!
  key: StringAggregate!
  name: StringAggregate!
  startsAt: DateTimeAggregate!
}

input FestivalCapacityFilter {
  """Equal to."""
  eq: Int

  """Greater than."""
  gt: Int

  """Greater than or equal to."""
  gte: Int

  """Less than."""
  lt: Int
}

type FestivalConnection {
  edges: [FestivalEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type FestivalEdge {
  cursor: String!
  node: Festival!
}

type FestivalFollowersConnection {
  edges: [FestivalFollowersEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

input FestivalFollowersConnectionWhere {
  edge: FollowsWhere
  node: UserWhere
}

type FestivalFollowersEdge {
  cursor: String!
  node: User!
  properties: Follows!
}

input FestivalFollowersFilter {
  """Every related node matches."""
  all: UserWhere

  """The number of related nodes."""
  count: CountFilter

  """No related node matches."""
  none: UserWhere

  """Exactly one related node matches."""
  single: UserWhere

  """At least one related node matches."""
  some: UserWhere
}

input FestivalKeyFilter {
  """Equal to."""
  eq: String

  """Equal to any of."""
  in: [String!]
}

input FestivalNameFilter {
  """Contains the substring."""
  contains: String

  """Equal to."""
  eq: String

  """Equal to any of."""
  in: [String!]

  """Starts with."""
  startsWith: String
}

"""Sorts Festival nodes. One field per item; the @key breaks ties."""
input FestivalSort {
  capacity: SortDirection
  key: SortDirection
  name: SortDirection
  startsAt: SortDirection
}

input FestivalStartsAtFilter {
  """Greater than or equal to."""
  gte: DateTime

  """Less than."""
  lt: DateTime
}

input FestivalStatusFilter {
  """Equal to."""
  eq: Status

  """Equal to any of."""
  in: [Status!]
}

"""Filters Festival nodes. Absent or null filters are ignored."""
input FestivalWhere {
  AND: [FestivalWhere!]
  NOT: FestivalWhere
  OR: [FestivalWhere!]
  capacity: FestivalCapacityFilter
  followers: FestivalFollowersFilter

  """Has a related Genre matching the filter."""
  genre: GenreWhere
  key: FestivalKeyFilter
  name: FestivalNameFilter
  startsAt: FestivalStartsAtFilter
  status: FestivalStatusFilter
}

type Follows {
  since: Int!
}

input FollowsSinceFilter {
  """Equal to."""
  eq: Int

  """Greater than or equal to."""
  gte: Int

  """Less than."""
  lt: Int
}

input FollowsWhere {
  AND: [FollowsWhere!]
  NOT: FollowsWhere
  OR: [FollowsWhere!]
  since: FollowsSinceFilter
}

type Genre {
  festivals(limit: Int, sort: [FestivalSort!], where: FestivalWhere): [Festival!]!
  festivalsConnection(after: String, first: Int, sort: [FestivalSort!], where: FestivalWhere): FestivalConnection!
  key: String!
  name: String!
}

type GenreConnection {
  edges: [GenreEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type GenreEdge {
  cursor: String!
  node: Genre!
}

input GenreKeyFilter {
  """Equal to."""
  eq: String

  """Equal to any of."""
  in: [String!]
}

input GenreNameFilter {
  """Equal to."""
  eq: String

  """Equal to any of."""
  in: [String!]

  """Starts with."""
  startsWith: String
}

"""Sorts Genre nodes. One field per item; the @key breaks ties."""
input GenreSort {
  key: SortDirection
  name: SortDirection
}

"""Filters Genre nodes. Absent or null filters are ignored."""
input GenreWhere {
  AND: [GenreWhere!]
  NOT: GenreWhere
  OR: [GenreWhere!]
  key: GenreKeyFilter
  name: GenreNameFilter
}

type IntAggregate {
  avg: Float
  max: Int
  min: Int
  sum: Float
}

"""An object with a global id."""
interface Node {
  id: ID!
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
}

type Query {
  """The Artist with this key, or null."""
  artist(key: ID!): Artist

  """Artist nodes, at most \`limit\` (default 25, max 100)."""
  artists(limit: Int, sort: [ArtistSort!], where: ArtistWhere): [Artist!]!

  """Artist nodes, paginated with keyset cursors."""
  artistsConnection(after: String, first: Int, sort: [ArtistSort!], where: ArtistWhere): ArtistConnection!

  """The Festival with this key, or null."""
  festival(key: String!): Festival

  """Festival nodes, at most \`limit\` (default 10, max 50)."""
  festivals(limit: Int, sort: [FestivalSort!], where: FestivalWhere): [Festival!]!
  festivalsAggregate(where: FestivalWhere): FestivalAggregate!

  """Festival nodes, paginated with keyset cursors."""
  festivalsConnection(after: String, first: Int, sort: [FestivalSort!], where: FestivalWhere): FestivalConnection!

  """The Genre with this key, or null."""
  genre(key: String!): Genre

  """Genre nodes, at most \`limit\` (default 25, max 100)."""
  genres(limit: Int, sort: [GenreSort!], where: GenreWhere): [Genre!]!

  """Genre nodes, paginated with keyset cursors."""
  genresConnection(after: String, first: Int, sort: [GenreSort!], where: GenreWhere): GenreConnection!

  """Fetch any object by its global id."""
  node(id: ID!): Node

  """The User with this key, or null."""
  user(key: String!): User

  """User nodes, at most \`limit\` (default 25, max 100)."""
  users(limit: Int, sort: [UserSort!], where: UserWhere): [User!]!

  """User nodes, paginated with keyset cursors."""
  usersConnection(after: String, first: Int, sort: [UserSort!], where: UserWhere): UserConnection!
}

enum SortDirection {
  """Ascending; nulls last."""
  ASC

  """Descending; nulls first."""
  DESC
}

enum Status {
  ANNOUNCED
  ON_SALE
  SOLD_OUT
}

type StringAggregate {
  max: String
  min: String
}

type User {
  follows(limit: Int, sort: [FestivalSort!], where: FestivalWhere): [Festival!]!
  followsConnection(after: String, first: Int, sort: [FestivalSort!], where: UserFollowsConnectionWhere): UserFollowsConnection!
  key: String!
  name: String
}

type UserConnection {
  edges: [UserEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type UserEdge {
  cursor: String!
  node: User!
}

type UserFollowsConnection {
  edges: [UserFollowsEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

input UserFollowsConnectionWhere {
  edge: FollowsWhere
  node: FestivalWhere
}

type UserFollowsEdge {
  cursor: String!
  node: Festival!
  properties: Follows!
}

input UserKeyFilter {
  """Equal to."""
  eq: String

  """Equal to any of."""
  in: [String!]
}

input UserNameFilter {
  """Equal to."""
  eq: String

  """Equal to any of."""
  in: [String!]
}

"""Sorts User nodes. One field per item; the @key breaks ties."""
input UserSort {
  key: SortDirection
  name: SortDirection
}

"""Filters User nodes. Absent or null filters are ignored."""
input UserWhere {
  AND: [UserWhere!]
  NOT: UserWhere
  OR: [UserWhere!]
  key: UserKeyFilter
  name: UserNameFilter
}"
`;
