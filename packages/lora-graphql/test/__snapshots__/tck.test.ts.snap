exports[`TCK > aggregate 1`] = `
[
  {
    "field": "festivalsAggregate",
    "reads": {
      "labels": [
        "Festival",
      ],
      "relationships": [],
    },
    "statements": [
      {
        "params": {
          "p0": 0,
        },
        "text": "MATCH (this:Festival)
WHERE this.capacity > $p0
RETURN count(this) AS \`count\`, max(this.capacity) AS capacity_max",
