exports[`TCK > relationship connection with properties 1`] = `
[
  {
    "field": "festival",
    "reads": {
      "labels": [
        "Festival",
        "User",
      ],
      "relationships": [
        "FOLLOWS",
      ],
    },
    "statements": [
      {
        "params": {
          "p0": "f1",
          "p1": 2000,
          "p2": 5,
          "p3": false,
          "p4": false,
          "p5": "key:ASC",
          "p6": 2000,
          "p7": 6,
        },
        "text": "MATCH (this:Festival)
WHERE this.key = $p0
CALL {
  WITH this
  MATCH (this)<-[this_followersConnection_rel:FOLLOWS]-(this_followersConnection:User)
  WHERE this_followersConnection_rel.since >= $p1
  WITH this_followersConnection_rel, this_followersConnection ORDER BY this_followersConnection.key ASC LIMIT $p7
  RETURN collect({ node: this_followersConnection { .key }, __cursor: [this_followersConnection.key], properties: this_followersConnection_rel { .since } }) AS this_followersConnection_rows
}
RETURN this { followersConnection: { __rows: this_followersConnection_rows, __first: $p2, __after: $p3, __backward: $p4, __sort: $p5, __totalCount: size([(this)<-[this_followersConnection_count_rel:FOLLOWS]-(this_followersConnection_count:User) WHERE this_followersConnection_count_rel.since >= $p6 | 1]) } } AS this",
      },
    ],
  },
]
`;

exports[`TCK > relationship filters 1`] = `
[
  {
    "field": "festivals",
    "reads": {
      "labels": [
        "Festival",
        "Genre",
        "User",
      ],
      "relationships": [
        "FOLLOWS",
        "IN_GENRE",
      ],
    },
    "statements": [
      {
        "params": {
          "p0": "H",
          "p1": "H",
          "p2": "u1",
          "p3": "u1",
          "p4": 1,
          "p5": "u1",
          "p6": 10,
        },
        "text": "MATCH (this_followers_anchor:User)
WHERE this_followers_anchor.key = $p5
MATCH (this_followers_anchor)-[:FOLLOWS]->(this:Festival)
WHERE size([(this)-[this_genre_rel:IN_GENRE]->(this_genre:Genre) WHERE this_genre.name STARTS WITH $p1 | 1]) > 0 AND size([(this)<-[this_followers_rel:FOLLOWS]-(this_followers:User) WHERE this_followers.key = $p3 | 1]) > 0 AND size(reduce(seen = [], seen_key IN [(this)<-[this_followers1_rel:FOLLOWS]-(this_followers1:User) | ["User", this_followers1.key]] | CASE WHEN seen_key IN seen THEN seen ELSE seen + [seen_key] END)) > $p4
WITH DISTINCT this
WITH this ORDER BY this.key ASC LIMIT $p6
RETURN this { .key } AS this",
      },
    ],
  },
]
`;

