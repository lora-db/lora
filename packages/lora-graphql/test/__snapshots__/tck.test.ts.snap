exports[`TCK > relationship connection with properties 1`] = `
[
  {
    "field": "festival",
    "reads": {
      "labels": [
        "Festival",
        "User",
      ],
      "relationships": [
        "FOLLOWS",
      ],
    },
    "statements": [
      {
        "params": {
          "p0": "f1",
          "p1": 2000,
          "p2": 5,
          "p3": false,
          "p4": "key:ASC",
          "p5": 2000,
          "p6": 6,
        },
        "text": "MATCH (this:Festival)
WHERE this.key = $p0
CALL {
  WITH this
  MATCH (this)<-[this_followersConnection_rel:FOLLOWS]-(this_followersConnection:User)
  WHERE this_followersConnection_rel.since >= $p1
  WITH this_followersConnection_rel, this_followersConnection ORDER BY this_followersConnection.key ASC LIMIT $p6
  RETURN collect({ node: this_followersConnection { .key }, __cursor: [this_followersConnection.key], properties: this_followersConnection_rel { .since } }) AS this_followersConnection_rows
}
RETURN this { followersConnection: { __rows: this_followersConnection_rows, __first: $p2, __after: $p3, __sort: $p4, __totalCount: size([(this)<-[this_followersConnection_count_rel:FOLLOWS]-(this_followersConnection_count:User) WHERE this_followersConnection_count_rel.since >= $p5 | 1]) } } AS this",
      },
    ],
  },
]
`;

exports[`TCK > relationship filters 1`] = `
[
  {
    "field": "festivals",
    "reads": {
      "labels": [
        "Festival",
        "Genre",
        "User",
      ],
      "relationships": [
        "FOLLOWS",
        "IN_GENRE",
      ],
    },
    "statements": [
      {
        "params": {
          "p0": "H",
          "p1": "u1",
          "p2": 1,
          "p3": "u1",
          "p4": 10,
        },
        "text": "MATCH (this_followers_anchor:User)
WHERE this_followers_anchor.key = $p3
MATCH (this_followers_anchor)-[:FOLLOWS]->(this:Festival)
WHERE size([(this)-[:IN_GENRE]->(this_genre:Genre) WHERE this_genre.name STARTS WITH $p0 | 1]) > 0 AND size([(this)<-[:FOLLOWS]-(this_followers:User) WHERE this_followers.key = $p1 | 1]) > 0 AND size([(this)<-[:FOLLOWS]-(this_followers1:User) | 1]) > $p2
WITH DISTINCT this
WITH this ORDER BY this.key ASC LIMIT $p4
RETURN this { .key } AS this",
      },
    ],
  },
]
`;

