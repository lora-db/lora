{
  "name": "@loradb/lora-graphql",
  "version": "0.15.0",
  "description": "Schema-first GraphQL for LoraDB: one annotated SDL becomes an executable, index-aware GraphQL API that compiles every operation to a single Cypher statement.",
  "license": "BUSL-1.1",
  "packageManager": "yarn@4.5.1",
  "author": "LoraDB, Inc.",
  "homepage": "https://github.com/lora-db/lora/tree/main/packages/lora-graphql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lora-db/lora.git",
    "directory": "packages/lora-graphql"
  },
  "bugs": {
    "url": "https://github.com/lora-db/lora/issues"
  },
  "keywords": [
    "lora",
    "loradb",
    "graphql",
    "cypher",
    "graph",
    "database"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test bench",
    "lint:fix": "eslint src test bench --fix",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "bench": "vitest bench --run"
  },
  "peerDependencies": {
    "@loradb/lora-node": "^0.15.0",
    "graphql": "^16.8.0 || ^17.0.0"
  },
  "devDependencies": {
    "@loradb/lora-node": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.15.0",
    "graphql": "^16.9.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@loradb/lora-node": {
      "optional": true
    }
  }
}
